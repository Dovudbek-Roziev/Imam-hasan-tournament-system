# RU: Скопируйте файл через npm run env:init; команда создаст случайный JWT_SECRET.
# EN: Run npm run env:init to copy this file and generate a random JWT_SECRET.
NODE_ENV=development
PORT=5000
# RU: Турнир проходит в Оше, Кыргызстан; часовой пояс сохраняется в новых матчах.
# EN: The tournament is held in Osh, Kyrgyzstan; new matches retain this time zone.
TOURNAMENT_TIME_ZONE=Asia/Bishkek
# RU: Нужен настроенный replica set (пример rs0) или MongoDB Atlas.
# EN: A configured replica set (rs0 in this example) or MongoDB Atlas is required.
MONGO_URI=mongodb://127.0.0.1:27017/imam_hasan?replicaSet=rs0
JWT_SECRET=
JWT_TTL_SECONDS=3600
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RU: Число доверенных прокси; меняйте только под фактическую схему размещения.
# EN: Trusted proxy hop count; change only to match the actual deployment topology.
TRUST_PROXY=0
