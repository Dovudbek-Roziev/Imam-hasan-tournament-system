{
  "name": "imam-hasan-tournament-backend",
  "version": "1.0.0",
  "description": "API системы управления футбольным турниром «Имам Хасан»",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "env:init": "node scripts/init-env.js",
    "admin:create": "node scripts/create-admin.js",
    "stats:rebuild": "node scripts/rebuild-stats.js",
    "demo:seed": "node scripts/seed-demo.js",
    "docs:generate": "node scripts/generate-openapi.js",
    "check": "node scripts/check-syntax.js",
    "lint": "oxlint --deny-warnings .",
    "test": "node --test --test-concurrency=1"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0",
    "oxlint": "^1.88.0"
  }
}
