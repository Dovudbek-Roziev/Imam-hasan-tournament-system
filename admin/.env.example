# Для локальной разработки запросы идут через Vite proxy; обычно переменную задавать не нужно.
# Для production укажите публичный backend URL с суффиксом /api.
# VITE_API_URL=https://your-api.example.com/api
# Локальная цель backend proxy (по умолчанию http://127.0.0.1:5000).
# API_PROXY_TARGET=http://127.0.0.1:5000
